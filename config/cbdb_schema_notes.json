{
  "sqlite_path": "data/cbdb/cbdb.sqlite",
  "preferred_views": [
    "View_AltnameData",
    "View_BiogAddrData",
    "View_BiogInstData",
    "View_BiogSourceData",
    "View_EntryData",
    "View_EventData",
    "View_PeopleData",
    "View_PeopleAddrData",
    "View_PostingAddrData",
    "View_PostingOfficeData"
  ],
  "person": {
    "priority": ["View_PeopleData", "BIOG_MAIN", "ALTNAME_DATA + BIOG_MAIN"],
    "tables": ["BIOG_MAIN", "ALTNAME_DATA", "ALTNAME_CODES", "DYNASTIES", "ADDR_CODES", "NIAN_HAO"],
    "fields": ["c_personid", "c_name", "c_name_chn", "c_index_year", "c_birthyear", "c_deathyear", "c_dy", "c_index_addr_id"]
  },
  "place": {
    "priority": ["ADDRESSES", "ADDR_CODES", "View_PeopleAddrData"],
    "tables": ["ADDR_CODES", "ADDRESSES", "BIOG_ADDR_DATA", "POSTED_TO_ADDR_DATA"],
    "fields": ["c_addr_id", "c_name", "c_name_chn", "x_coord", "y_coord"]
  },
  "office": {
    "priority": ["View_PostingOfficeData", "OFFICE_CODES"],
    "tables": ["OFFICE_CODES", "POSTED_TO_OFFICE_DATA", "View_PostingOfficeData"],
    "fields": ["c_office_id", "c_office_chn", "c_office_pinyin", "c_office_trans"]
  },
  "reign": {
    "priority": ["NIAN_HAO", "DYNASTIES"],
    "tables": ["NIAN_HAO", "DYNASTIES"],
    "fields": ["c_nianhao_id", "c_nianhao_chn", "c_nianhao_pin", "c_dy"]
  }
}
