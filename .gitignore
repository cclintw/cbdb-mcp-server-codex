.mypy_cache/
.ruff_cache/

# macOS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# CBDB data: do not commit downloaded database archives
data/cbdb/*.sqlite
data/cbdb/*.sqlite3
data/cbdb/*.db
data/cbdb/*.zip
data/cbdb/*.7z
data/cbdb/*.json

# User texts: keep only the bundled demo sample tracked
data/input/*
!data/input/sample-1.txt

# Generated output
data/output/
*.html

# Published static demo
!demo/index.html

# Local writing / prompt drafts
AGENTS.md
doc/
prompts/
src/
templates/

# Keep folder notes trackable
!data/cbdb/README.md

# Local logs and temp files
*.log
tmp/
temp/
